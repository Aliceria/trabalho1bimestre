{
  "info": {
    "name": "API de Jogos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Cadastrar jogo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/jogo",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Minecraft\",\n  \"genero\": \"Sandbox\",\n  \"plataforma\": \"PC\",\n  \"preco\": 99.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar jogos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jogo"
      }
    },
    {
      "name": "Buscar por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jogo/{{id}}"
      }
    },
    {
      "name": "Filtrar nome",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jogo?nome=Minecraft"
      }
    },
    {
      "name": "Filtrar genero",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jogo?genero=Sandbox"
      }
    },
    {
      "name": "Filtrar plataforma",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jogo?plataforma=PC"
      }
    },
    {
      "name": "Combinar filtros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/jogo?nome=Minecraft&genero=Sandbox&plataforma=PC"
      }
    },
    {
      "name": "Atualizar jogo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/jogo/{{id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Minecraft\",\n  \"genero\": \"Sandbox\",\n  \"plataforma\": \"PC\",\n  \"preco\": 79.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Excluir jogo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/jogo/{{id}}"
      }
    }
  ]
}
